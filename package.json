{
  "name": "payonce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "tsx src/surfaces/cli/dev.ts",
    "recover": "tsx src/surfaces/cli/recover.ts",
    "approve": "tsx src/surfaces/cli/approve.ts",
    "close": "tsx src/surfaces/cli/close.ts",
    "audit": "tsx src/surfaces/cli/audit.ts",
    "cash": "tsx src/surfaces/cli/cash.ts",
    "board": "tsx src/surfaces/cli/board.ts",
    "payrun": "tsx src/surfaces/cli/payrun.ts",
    "outbox": "tsx src/surfaces/cli/outbox.ts",
    "outage": "tsx src/surfaces/cli/outage.ts",
    "supplier": "tsx src/surfaces/cli/supplier.ts",
    "reconcile": "tsx src/surfaces/cli/reconcile.ts",
    "ask": "tsx src/surfaces/cli/ask.ts",
    "metrics": "tsx src/surfaces/cli/metrics.ts",
    "reset": "tsx src/surfaces/cli/reset.ts",
    "preui": "node scripts/build-web.mjs",
    "ui": "tsx src/surfaces/http/main.ts",
    "mcp": "tsx src/surfaces/mcp/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test",
    "test": "tsx --test --test-timeout=60000 test/*.test.ts",
    "build:web": "node scripts/build-web.mjs",
    "check:layers": "node scripts/check-layers.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "preact": "10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
