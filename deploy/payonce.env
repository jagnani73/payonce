# PayOnce on the AWS server, read by payonce.service from the release it runs.
# The Airwallex keys and PUBLIC_ORIGIN come from Parameter Store at each start
# (payonce-env), never from this file. No model key: emails are read by keywords.
AWX_BASE_URL=https://api.sandbox.airwallex.com
APPROVERS=Yash:50000,Alex:10000,Kim:10000,Sam:4200
TWO_APPROVERS_ABOVE=5000
# Requests opened by the 03:00 morning stay open until the next morning resets the ledger.
APPROVAL_TTL_MINUTES=1500
RESERVE_FLOORS=USD:1000000,EUR:1000000
WEBHOOKS=off
RECON_EVERY_MINUTES=10
DAILY_PAYMENT_CAP=20
PORT=4310
