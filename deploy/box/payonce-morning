#!/bin/bash
# payonce-morning: the nightly fresh morning, run as root by payonce-morning.timer.
# Stops PayOnce, moves the ledger aside with pnpm reset's script, deletes ledgers
# moved aside more than 3 days ago, starts PayOnce again and sets up the demo's
# morning with scripts/demo-morning.mjs, which makes 5 sandbox transfers.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
app=/opt/payonce/current
if [[ ! -f "$app/package.json" ]]; then
  echo "payonce-morning: no release is deployed yet" >&2
  exit 1
fi

exec 9>/run/payonce-ops.lock
flock -w 600 9

healthy() {
  for _ in $(seq 1 30); do
    if curl -fsS -o /dev/null --max-time 3 http://127.0.0.1:4310/api/status && systemctl is-active --quiet payonce; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Runs a command as payonce in a transient unit with payonce.service's sandbox:
# it writes only the ledger's folder and cannot reach the instance metadata service.
as_payonce() {
  systemd-run --wait --pipe --collect --quiet \
    -p User=payonce -p Group=payonce -p WorkingDirectory=/var/lib/payonce \
    -p Requires=payonce-imds.service -p After=payonce-imds.service \
    -p NoNewPrivileges=yes -p ProtectSystem=strict -p ReadWritePaths=/var/lib/payonce \
    -p ProtectHome=yes -p PrivateTmp=yes -p PrivateDevices=yes -p ProtectKernelTunables=yes \
    -p ProtectKernelModules=yes -p ProtectControlGroups=yes -p RestrictSUIDSGID=yes \
    -p LockPersonality=yes -p UMask=0077 -p MemoryMax=1200M \
    -p "IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128" \
    "$@"
}

systemctl stop payonce
as_payonce "$app/node_modules/.bin/tsx" --tsconfig "$app/tsconfig.json" "$app/src/surfaces/cli/reset.ts"
find /var/lib/payonce -maxdepth 1 -type f -name 'payonce.*.db' -mmin +4320 -print -delete
systemctl start payonce
if ! healthy; then
  echo "payonce-morning: PayOnce did not answer within 60 s after the reset" >&2
  exit 1
fi
as_payonce /usr/local/bin/node "$app/scripts/demo-morning.mjs" http://127.0.0.1:4310
