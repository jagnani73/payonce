# Airwallex sandbox
AWX_CLIENT_ID!
AWX_API_KEY!
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Email reader
READER_API_KEY            # a Gemini API key; without it the keyword placeholder reads the emails
READER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
READER_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite   # tried in order

# Approvals
APPROVERS                     # name:limit pairs such as Alex:50000,Sam:5000; without it nobody can approve
TWO_APPROVERS_ABOVE=5000      # in the currency the payment is paid from
APPROVAL_TTL_MINUTES=60

# Cash
RESERVE_FLOORS                # currency:amount pairs such as USD:1000000,EUR:1000000; a currency not listed never replaces by itself

# FX
FX_QUOTE_VALIDITY=MIN_30|HR_1|HR_4|HR_8|HR_24   # default: HR_1

# Web UI
PORT=4310

# Bank deadlines
BANK_DEADLINE_LOCAL_MINUTES=3   # minutes the bank has to pay or fail a transfer before a person hears about it
BANK_DEADLINE_SWIFT_MINUTES=5

# Alerts
ALERT_WEBHOOK_URL              # a Slack or Discord incoming webhook; without it nothing is posted
ALERT_FORMAT=slack|discord     # default: slack
ALERT_TEST_RECEIVER_URL        # a loopback receiver for checking alerts; wins over ALERT_WEBHOOK_URL

# Webhooks
WEBHOOKS=tunnel|off            # default: tunnel
WEBHOOK_PORT=4311
WEBHOOK_URL                    # a public address that forwards to WEBHOOK_PORT; without it cloudflared opens a quick tunnel
CLOUDFLARED=cloudflared        # path to the cloudflared executable
WEBHOOK_API_VERSION=2025-06-30
