# Airwallex sandbox
AWX_CLIENT_ID!
AWX_API_KEY!
AWX_BASE_URL=https://api.sandbox.airwallex.com|https://api-demo.airwallex.com|https://sandbox.invalid  # default: the first; the last is offline

# Email reader and Ask why
CLAUDE_API_KEY                                      # Anthropic key, asked first; not ANTHROPIC_API_KEY, which Claude Code reads
CLAUDE_MODEL=claude-haiku-5-5,claude-sonnet-5-5     # tried in order
READER_API_KEY                                      # Gemini key, asked after Claude; with neither key, keywords read emails
READER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
READER_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite # tried in order

# Approvals
APPROVERS                                           # name:limit pairs, e.g. Yash:50000,Alex:10000,Kim:10000,Sam:4200; unset, nobody approves
TWO_APPROVERS_ABOVE=5000                            # in the currency paid from
APPROVAL_TTL_MINUTES=60

# Cash
RESERVE_FLOORS                                      # CUR:amount pairs, e.g. USD:1000000,EUR:1000000; unlisted, a person decides

# FX
FX_QUOTE_VALIDITY=MIN_30|HR_1|HR_4|HR_8|HR_24       # default: HR_1

# Web UI
PORT=4310

# Bank deadlines
BANK_DEADLINE_LOCAL_MINUTES=3                       # before a person hears
BANK_DEADLINE_SWIFT_MINUTES=5

# Outages
OUTAGE_FAILURES=3                                   # payees failing on one rail that declare an outage
OUTAGE_WINDOW_MINUTES=30

# Reconciliation
RECON_EVERY_MINUTES=10                              # 0 turns the server's runs off

# Alerts
ALERT_WEBHOOK_URL                                   # Slack or Discord incoming webhook; unset, nothing is posted
ALERT_FORMAT=slack|discord                          # default: slack
ALERT_TEST_RECEIVER_URL                             # loopback receiver for testing; wins over ALERT_WEBHOOK_URL

# Webhooks
WEBHOOKS=on|off                                     # default: on; off for the sandbox
WEBHOOK_PORT=4311
WEBHOOK_URL                                         # public address forwarding to WEBHOOK_PORT; unset, cloudflared opens one
CLOUDFLARED=cloudflared                             # path to cloudflared
WEBHOOK_API_VERSION=2025-06-30
